"use client";

import { useState, useEffect, useRef } from "react";
import { AgentState, AgentEvent, AgentEventType, Tool, RiskLevel } from "@nova/shared";

const STEP_STATUSES: Record<AgentEventType, { label: string; icon: React.ReactNode }> = {
  understanding_started: { label: "Understanding request", icon: <Brain className="w-4 h-4" /> },
  understanding_completed: { label: "Understanding request", icon: <CheckCircle className="w-4 h-4 text-green-500" /> },
  context_loading_started: { label: "Loading context", icon: <Database className="w-4 h-4" /> },
  context_loading_completed: { label: "Loading context", icon: <CheckCircle className="w-4 h-4 text-green-500" /> },
  planning_started: { label: "Building plan", icon: <ListTodo className="w-4 h-4" /> },
  planning_completed: { label: "Building plan", icon: <CheckCircle className="w-4 h-4 text-green-500" /> },
  execution_started: { label: "Executing plan", icon: <PlayCircle className="w-4 h-4" /> },
  step_started: { label: "Running step", icon: <Loader2 className="w-4 h-4 animate-spin" /> },
  step_completed: { label: "Step completed", icon: <CheckCircle className="w-4 h-4 text-green-500" /> },
  step_failed: { label: "Step failed", icon: <XCircle className="w-4 h-4 text-red-500" /> },
  approval_required: { label: "Approval required", icon: <AlertTriangle className="w-4 h-4 text-amber-500" /> },
  approval_received: { label: "Approval received", icon: <CheckCircle className="w-4 h-4 text-green-500" /> },
  verification_started: { label: "Verifying results", icon: <Search className="w-4 h-4" /> },
  verification_completed: { label: "Verifying results", icon: <CheckCircle className="w-4 h-4 text-green-500" /> },
  execution_completed: { label: "Completed", icon: <CheckCircle className="w-4 h-4 text-green-500" /> },
  execution_failed: { label: "Failed", icon: <XCircle className="w-4 h-4 text-red-500" /> },
  execution_cancelled: { label: "Cancelled", icon: <XCircle className="w-4 h-4 text-slate-500" /> },
};

function Brain({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 5a3 3 0 1 0-3 3c0 1.5 1 2.5 2 3 1-.5 2-1.5 2-3z"/><path d="M19 11a3 3 0 1 0-3 3c0 1.5 1 2.5 2 3 1-.5 2-1.5 2-3z"/><path d="M5 17a3 3 0 1 0-3 3c0 1.5 1 2.5 2 3 1-.5 2-1.5 2-3z"/><path d="M12 11a5 5 0 0 1 5 5"/><path d="M7 16a5 5 0 0 0 5 5"/></svg>;
}

function CheckCircle({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>;
}

function Database({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/></svg>;
}

function ListTodo({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7"/><path d="M5 21v-7"/><path d="M3 12v7"/></svg>;
}

function PlayCircle({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16"/></svg>;
}

function Loader2({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>;
}

function XCircle({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>;
}

function AlertTriangle({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>;
}

function Search({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>;
}

function Send({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9"/></svg>;
}

function X({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>;
}

function Sparkles({ className }: { className?: string }) {
  return <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 3v1"/><path d="M12 20v1"/><path d="M3 12H2"/><path d="M21 12h1"/><path d="m18.49 4.49.71.71"/><path d="M4.93 19.07.71.71"/><path d="m4.49 18.49-.71.71"/><path d="M19.07 4.93-.71-.71"/></svg>;
}

interface PlanStep {
  id: string;
  description: string;
  tool: string;
  risk: RiskLevel;
  status: "pending" | "running" | "completed" | "failed" | "skipped";
}

interface ApprovalRequest {
  id: string;
  stepId: string;
  tool: string;
  arguments: Record<string, unknown>;
  risk: RiskLevel;
  reason: string;
}

export default function NovaApp() {
  const [input, setInput] = useState("");
  const [state, setState] = useState<AgentState>(AgentState.IDLE);
  const [events, setEvents] = useState<AgentEvent[]>([]);
  const [planSteps, setPlanSteps] = useState<PlanStep[]>([]);
  const [approvalRequest, setApprovalRequest] = useState<ApprovalRequest | null>(null);
  const [result, setResult] = useState<{ success: boolean; summary: string } | null>(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const eventsEndRef = useRef<HTMLDivElement>(null);

  const scrollToBottom = () => {
    eventsEndRef.current?.scrollIntoView({ behavior: "smooth" });
  };

  useEffect(() => {
    scrollToBottom();
  }, [events]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!input.trim() || isProcessing) return;

    setIsProcessing(true);
    setState(AgentState.UNDERSTANDING);
    setEvents([]);
    setPlanSteps([]);
    setApprovalRequest(null);
    setResult(null);

    try {
      const response = await fetch("/api/agent/execute", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: input, userId: "user_001" }),
      });

      const data = await response.json();

      if (data.events) {
        setEvents(data.events);
      }
      if (data.planSteps) {
        setPlanSteps(data.planSteps);
      }
      if (data.approvalRequest) {
        setApprovalRequest(data.approvalRequest);
        setState(AgentState.WAITING_FOR_APPROVAL);
      }
      if (data.result) {
        setResult(data.result);
        setState(data.result.success ? AgentState.COMPLETED : AgentState.FAILED);
      }
    } catch (error) {
      console.error("Execution error:", error);
      setResult({ success: false, summary: "Failed to execute goal" });
      setState(AgentState.FAILED);
    } finally {
      setIsProcessing(false);
    }
  };

  const handleApprove = async (approved: boolean) => {
    if (!approvalRequest) return;

    try {
      const response = await fetch("/api/agent/approve", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ requestId: approvalRequest.id, approved }),
      });

      const data = await response.json();

      if (data.events) {
        setEvents(data.events);
      }
      if (data.planSteps) {
        setPlanSteps(data.planSteps);
      }
      if (data.approvalRequest) {
        setApprovalRequest(data.approvalRequest);
      } else {
        setApprovalRequest(null);
      }
      if (data.result) {
        setResult(data.result);
        setState(data.result.success ? AgentState.COMPLETED : AgentState.FAILED);
      }
    } catch (error) {
      console.error("Approval error:", error);
    }
  };

  const getStateLabel = (s: AgentState) => {
    const labels: Record<AgentState, string> = {
      IDLE: "Ready",
      UNDERSTANDING: "Understanding",
      CONTEXT_LOADING: "Loading Context",
      PLANNING: "Planning",
      EXECUTING: "Executing",
      WAITING_FOR_APPROVAL: "Waiting for Approval",
      VERIFYING: "Verifying",
      COMPLETED: "Completed",
      FAILED: "Failed",
      CANCELLED: "Cancelled",
    };
    return labels[s];
  };

  const getStateColor = (s: AgentState) => {
    const colors: Record<AgentState, string> = {
      IDLE: "bg-slate-100 text-slate-600",
      UNDERSTANDING: "bg-blue-100 text-blue-700",
      CONTEXT_LOADING: "bg-blue-100 text-blue-700",
      PLANNING: "bg-purple-100 text-purple-700",
      EXECUTING: "bg-indigo-100 text-indigo-700",
      WAITING_FOR_APPROVAL: "bg-amber-100 text-amber-700",
      VERIFYING: "bg-cyan-100 text-cyan-700",
      COMPLETED: "bg-green-100 text-green-700",
      FAILED: "bg-red-100 text-red-700",
      CANCELLED: "bg-slate-100 text-slate-600",
    };
    return colors[s];
  };

  return (
    <div className="min-h-screen flex flex-col">
      <header className="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 sticky top-0 z-10">
        <div className="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-nova-500 to-nova-700 flex items-center justify-center">
              <Sparkles className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="text-xl font-bold text-slate-900 dark:text-white">NOVA</h1>
              <p className="text-xs text-slate-500 dark:text-slate-400">Context-Aware Goal-to-Action Agent</p>
            </div>
          </div>
          <div className="flex items-center gap-3">
            <span className={`px-3 py-1 rounded-full text-sm font-medium ${getStateColor(state)}`}>
              {getStateLabel(state)}
            </span>
            {isProcessing && (
              <Loader2 className="w-5 h-5 text-nova-500 animate-spin" />
            )}
          </div>
        </div>
      </header>

      <main className="flex-1 max-w-7xl mx-auto w-full px-4 py-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div className="lg:col-span-2 space-y-6">
          <section className="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
            <div className="px-6 py-4 border-b border-slate-200 dark:border-slate-800">
              <h2 className="text-lg font-semibold text-slate-900 dark:text-white">Conversation</h2>
            </div>
            <div className="p-6 space-y-4 max-h-[500px] overflow-y-auto scrollbar-thin">
              {events.map((event) => {
                const status = STEP_STATUSES[event.type];
                if (!status) return null;
                return (
                  <div key={event.id} className="flex items-start gap-3 text-sm">
                    <div className="flex-shrink-0 mt-0.5 text-slate-400">{status.icon}</div>
                    <div className="flex-1">
                      <p className="text-slate-700 dark:text-slate-300">{status.label}</p>
                      {event.message !== status.label && (
                        <p className="text-slate-500 dark:text-slate-400 mt-1">{event.message}</p>
                      )}
                      <p className="text-xs text-slate-400 mt-1">
                        {new Date(event.timestamp).toLocaleTimeString()}
                      </p>
                    </div>
                  </div>
                );
              })}
              <div ref={eventsEndRef} />
            </div>
            <div className="px-6 py-4 border-t border-slate-200 dark:border-slate-800">
              <form onSubmit={handleSubmit} className="flex gap-2">
                <input
                  type="text"
                  value={input}
                  onChange={(e) => setInput(e.target.value)}
                  placeholder="Describe your goal... (e.g., \"I have six guests coming tomorrow at 6 PM. Get everything ready.\")"
                  className="flex-1 px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-nova-500 focus:border-transparent"
                  disabled={isProcessing}
                />
                <button
                  type="submit"
                  disabled={isProcessing || !input.trim()}
                  className="px-6 py-2 bg-nova-600 text-white rounded-lg font-medium hover:bg-nova-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                >
                  <Send className="w-5 h-5" />
                </button>
              </form>
            </div>
          </section>

          {planSteps.length > 0 && (
            <section className="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
              <div className="px-6 py-4 border-b border-slate-200 dark:border-slate-800">
                <h2 className="text-lg font-semibold text-slate-900 dark:text-white">Execution Plan</h2>
              </div>
              <div className="p-6 space-y-3">
                {planSteps.map((step) => (
                  <div
                    key={step.id}
                    className={`flex items-center gap-3 p-3 rounded-lg border transition-colors ${
                      step.status === "running"
                        ? "bg-indigo-50 dark:bg-indigo-900/20 border-indigo-200"
                        : step.status === "completed"
                        ? "bg-green-50 dark:bg-green-900/20 border-green-200"
                        : step.status === "failed"
                        ? "bg-red-50 dark:bg-red-900/20 border-red-200"
                        : step.status === "skipped"
                        ? "bg-slate-50 dark:bg-slate-800 border-slate-200"
                        : "bg-slate-50 dark:bg-slate-800 border-slate-200"
                    }`}
                  >
                    <div className="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-medium">
                      {step.status === "completed" && <CheckCircle className="w-5 h-5 text-green-500" />}
                      {step.status === "running" && <Loader2 className="w-5 h-5 text-indigo-500 animate-spin" />}
                      {step.status === "failed" && <XCircle className="w-5 h-5 text-red-500" />}
                      {step.status === "skipped" && <X className="w-5 h-5 text-slate-400" />}
                      {step.status === "pending" && <span className="text-slate-400">⏳</span>}
                    </div>
                    <div className="flex-1 min-w-0">
                      <p className="font-medium text-slate-900 dark:text-white truncate">{step.description}</p>
                      <div className="flex items-center gap-2 mt-1 text-xs text-slate-500">
                        <span className="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono">{step.tool}</span>
                        <span className={`px-2 py-0.5 rounded text-xs ${
                          step.risk === RiskLevel.READ_ONLY ? "bg-blue-100 text-blue-700" :
                          step.risk === RiskLevel.LOW_RISK_WRITE ? "bg-amber-100 text-amber-700" :
                          "bg-red-100 text-red-700"
                        }`}>{step.risk}</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          {approvalRequest && (
            <section className="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-6">
              <div className="flex items-start gap-3">
                <AlertTriangle className="w-6 h-6 text-amber-500 flex-shrink-0 mt-0.5" />
                <div className="flex-1">
                  <h3 className="text-lg font-semibold text-amber-800 dark:text-amber-200">Approval Required</h3>
                  <p className="text-amber-700 dark:text-amber-300 mt-1">{approvalRequest.reason}</p>
                  <div className="mt-3 p-3 bg-white dark:bg-slate-800 rounded-lg text-sm">
                    <p className="font-mono text-slate-700 dark:text-slate-300">{approvalRequest.tool}</p>
                    <pre className="mt-2 text-xs text-slate-500 overflow-auto max-h-32">{JSON.stringify(approvalRequest.arguments, null, 2)}</pre>
                  </div>
                  <div className="flex gap-3 mt-4">
                    <button
                      onClick={() => handleApprove(true)}
                      className="px-4 py-2 bg-green-600 text-white rounded-lg font-medium hover:bg-green-700 transition-colors"
                    >
                      Approve
                    </button>
                    <button
                      onClick={() => handleApprove(false)}
                      className="px-4 py-2 bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 transition-colors"
                    >
                      Reject
                    </button>
                  </div>
                </div>
              </div>
            </section>
          )}

          {result && (
            <section className={`rounded-xl p-6 ${
              result.success
                ? "bg-green-50 dark:bg-green-900/20 border border-green-200"
                : "bg-red-50 dark:bg-red-900/20 border border-red-200"
            }`}>
              <div className="flex items-start gap-3">
                {result.success ? (
                  <CheckCircle className="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" />
                ) : (
                  <XCircle className="w-6 h-6 text-red-500 flex-shrink-0 mt-0.5" />
                )}
                <div className="flex-1">
                  <h3 className="text-lg font-semibold text-slate-900 dark:text-white">
                    {result.success ? "Goal Completed" : "Goal Failed"}
                  </h3>
                  <p className="text-slate-700 dark:text-slate-300 mt-1">{result.summary}</p>
                </div>
              </div>
            </section>
          )}
        </div>

        <aside className="space-y-6">
          <section className="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6">
            <h3 className="text-lg font-semibold text-slate-900 dark:text-white mb-4">Available Tools</h3>
            <div className="space-y-2">
              {[
                { name: "get_calendar_context", risk: RiskLevel.READ_ONLY, desc: "Check calendar events" },
                { name: "get_weather_context", risk: RiskLevel.READ_ONLY, desc: "Check weather forecast" },
                { name: "get_tasks", risk: RiskLevel.READ_ONLY, desc: "View pending tasks" },
                { name: "update_task", risk: RiskLevel.LOW_RISK_WRITE, desc: "Update task status" },
                { name: "manage_shopping_list", risk: RiskLevel.LOW_RISK_WRITE, desc: "Manage shopping list" },
                { name: "create_reminder", risk: RiskLevel.LOW_RISK_WRITE, desc: "Create reminders" },
                { name: "get_user_context", risk: RiskLevel.READ_ONLY, desc: "Get user preferences" },
              ].map((tool) => (
                <div key={tool.name} className="flex items-center gap-2 p-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800">
                  <span className={`px-2 py-0.5 rounded text-xs font-mono ${
                    tool.risk === RiskLevel.READ_ONLY ? "bg-blue-100 text-blue-700" :
                    tool.risk === RiskLevel.LOW_RISK_WRITE ? "bg-amber-100 text-amber-700" :
                    "bg-red-100 text-red-700"
                  }`}>{tool.risk}</span>
                  <span className="text-sm text-slate-700 dark:text-slate-300">{tool.desc}</span>
                </div>
              ))}
            </div>
          </section>

          <section className="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6">
            <h3 className="text-lg font-semibold text-slate-900 dark:text-white mb-4">Quick Examples</h3>
            <div className="space-y-2">
              {[
                "I have six guests coming tomorrow at 6 PM. Get everything ready.",
                "Plan a weekend trip to Tokyo for next month.",
                "Prepare for my presentation on Friday morning.",
                "Organize a team building event for next week.",
              ].map((example) => (
                <button
                  key={example}
                  onClick={() => setInput(example)}
                  disabled={isProcessing}
                  className="w-full text-left p-3 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-sm text-slate-700 dark:text-slate-300 transition-colors disabled:opacity-50"
                >
                  {example}
                </button>
              ))}
            </div>
          </section>
        </aside>
      </main>
    </div>
  );
}